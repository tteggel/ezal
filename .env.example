# ezal WiFi credentials — station (STA) mode
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your network:
#
#     cp .env.example .env && $EDITOR .env
#
# `.env` is git-ignored, so your credentials never get committed. At build
# time `crates/ezal-firmware/build.rs` bakes these two values into the
# firmware image (the Pico has no filesystem to read them from at runtime),
# and the on-chip WiFi POST joins this access point at boot.
#
# ⚠  The values end up in the flashed image in the clear — there's no secure
#    element on the board. Treat built `.elf`/`.uf2` artefacts accordingly.
#
# Constraints (validated by the POST, see crates/ezal-core/src/wifi.rs):
#   EZAL_WIFI_SSID     — 1 to 32 UTF-8 bytes. Required.
#   EZAL_WIFI_PASSWORD — 8 to 63 UTF-8 bytes for WPA3/SAE.
#                        Leave BLANK for an open (unencrypted) network.

EZAL_WIFI_SSID=my-network-name
EZAL_WIFI_PASSWORD=change-me-please

# Receiver site: All Saints Church, East Clevedon. East-positive longitude.
# Height above WGS84 is unmeasured; set the actual antenna height when known.
EZAL_LATITUDE_DEG=51.44266
EZAL_LONGITUDE_DEG=-2.84053
EZAL_ALTITUDE_M=0
# Acquisition/loss elevation and the minimum peak for a useful pass.
EZAL_MIN_ELEVATION_DEG=5
EZAL_MIN_PEAK_ELEVATION_DEG=10
# Legacy FY-3A/B/C candidates (inactive/unconfirmed, FY-3C restricted to China).
EZAL_INCLUDE_EXPERIMENTAL=false
